{
    "name": "stemizer/filament_tinyfinder",
    "description": "Compact file manager plugin for Filament - Upload, manage, and organize your files and images with advanced features",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "file-manager",
        "image-manager",
        "tinyfinder",
        "admin-panel"
    ],
    "homepage": "https://github.com/samettemizer/filament_tinyfinder",
    "license": "MIT",
    "authors": [
        {
            "name": "Samet TEMIZER",
            "email": "nestisamet@gmail.com",
            "homepage": "https://stemizer.net"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.6",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "intervention/image": "^3.7",
        "livewire/livewire": "^4.1"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "nunomaduro/collision": "^8.4",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Stemizer\\FilamentTinyFinder\\": "src/",
            "Stemizer\\FilamentTinyFinder\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stemizer\\FilamentTinyFinder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run build:assets"
        ],
        "build:assets": "npm run build",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Stemizer\\FilamentTinyFinder\\FilamentTinyFinderServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
